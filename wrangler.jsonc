{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bursa-musangking-strategy-terminal",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bursa-musangking-strategy-terminal",
    "database_id": "4c9bbff9-8007-4769-90b3-e79bbce4d338"
  }],
  "vars": {
    "MIN_UNIVERSE": "900",
    "NEAR_STOP_PCT": "3",
    "APP_TITLE": "Bursa Strategy Terminal"
  }
}
